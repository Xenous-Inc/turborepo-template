# Config for `@xenous/storage`: any S3-compatible store (MinIO locally, S3 or R2 in deploys).
# Defaults match the local MinIO in `docker-compose.yml`.
# Credentials belong in `packages/storage/.env.local`.
#
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# API endpoint, not the MinIO web console (that one is on port 9001).
# For R2 it is `https://<account-id>.r2.cloudflarestorage.com`.
# @type=url(allowedProtocols=[http, https])
# @docs("MinIO S3 API", https://min.io/docs/minio/linux/developers/minio-drivers.html)
# @docs("R2 S3 API", https://developers.cloudflare.com/r2/api/s3/api/)
S3_ENDPOINT=http://localhost:9000

# MinIO ignores it, but the AWS SDK requires one. R2 uses `auto`.
# @type=string(matches=regex("^[a-z0-9-]+$"))
# @example="eu-central-1"
S3_REGION=us-east-1

# Must exist already. Locally `minio-init` creates it with public read.
# @type=string(matches=regex("^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"))
# @docs("Bucket naming rules", https://docs.aws.amazon.com/AmazonS3/latest/userguide/bucketnamingrules.html)
S3_BUCKET=xenous

# Locally these are MinIO's root user and password from `docker-compose.yml`.
# @required @sensitive @example="minio"
S3_ACCESS_KEY_ID=
# @required @sensitive @example="password"
S3_SECRET_ACCESS_KEY=

# Puts the bucket in the path (`host/bucket/key`) instead of the subdomain.
# MinIO needs it with the AWS SDK. S3 and R2 work either way.
# @type=boolean
S3_FORCE_PATH_STYLE=true
