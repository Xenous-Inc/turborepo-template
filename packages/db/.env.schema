# Config for `@xenous/db`. The default matches the local Postgres in `docker-compose.yml`.
# Override it in `packages/db/.env.local`.
#
# @defaultRequired=infer
# @defaultSensitive=false
#
# @import(../../, pick=[NODE_ENV, COOLIFY_PREVIEW, COOLIFY_BRANCH])
#
# @generateTsTypes(path=./env.d.ts)
# ---

# Base connection string. Previews get their own database, so code reads `databaseUrl` instead.
# @required @sensitive
# @deprecated="Import `databaseUrl` from `@xenous/db/url`, which points previews at their own database."
# @type=url(allowedProtocols=[postgres, postgresql])
# @docs("Drizzle postgres-js", https://orm.drizzle.team/docs/get-started-postgresql)
DATABASE_URL=postgresql://postgres:password@localhost:5432/default
