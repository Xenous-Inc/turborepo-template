# Config for the `next` app. `NEXT_PUBLIC_` items are public and inlined into the client bundle.
#
# @defaultRequired=infer
# @defaultSensitive=inferFromPrefix('NEXT_PUBLIC_')
#
# @import(../../, pick=[NODE_ENV, DOCKER, PORT, HOST, COOLIFY_*, SOURCE_COMMIT])
#
# @generateTsTypes(path=./env.d.ts)
# ---

# SSR-side URL for the `server` app; may differ from NEXT_PUBLIC_SERVER_URL on an internal network.
# @required @public @type=url
SERVER_URL=http://localhost:3000

# Browser-side URL for the `server` app.
# @required @type=url
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# @optional @type=boolean
NEXT_PUBLIC_NEXT_DEVTOOLS_ENABLED=false
# @optional @type=boolean
NEXT_PUBLIC_QUERY_DEVTOOLS_ENABLED=true
