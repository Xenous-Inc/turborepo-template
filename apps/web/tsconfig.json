{
    "$schema": "https://schemastore.org/tsconfig.json",
    "extends": "@xenous/typescript/base.json",
    "compilerOptions": {
        /** Base Options */
        "module": "esnext",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "jsx": "preserve",
        "types": ["node", "@xenous/ui/types/icon"],

        /** Plugins */
        "plugins": [
            {
                "name": "next"
            }
        ],

        /** Aliases */
        "paths": {
            "@xenous/ui/*": ["../../packages/ui/src/*"],
            "~/orpc": ["./orpc/index.ts"],
            "~/orpc/*": ["./orpc/*"],
            "~/public/*": ["./public/*"],
            "~/*": ["./src/*"]
        }
    },
    "include": [
        "./**/*.ts",
        "./**/*.tsx",
        ".next/types/**/*.ts",
        "next-env.d.ts"
    ],
    "exclude": ["public"],
    "references": [
        {
            "path": "../server"
        }
    ]
}
