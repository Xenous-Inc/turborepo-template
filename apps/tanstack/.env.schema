# Config for the `tanstack` app. `VITE_` items are public and inlined into the client bundle.
#
# @defaultRequired=infer
# @defaultSensitive=inferFromPrefix('VITE_')
#
# @import(../../, pick=[NODE_ENV, DOCKER, PORT, HOST, COOLIFY_*, SOURCE_COMMIT])
#
# @generateTsTypes(path=./env.d.ts)
# ---

# SSR-side URL for the `server` app; may differ from VITE_SERVER_URL on an internal network.
# @required @public @type=url
SERVER_URL=http://localhost:3000

# Browser-side URL for the `server` app.
# @required @type=url
VITE_SERVER_URL=http://localhost:3000

# @optional @type=boolean
VITE_ROUTER_DEVTOOLS_ENABLED=true
# @optional @type=boolean
VITE_QUERY_DEVTOOLS_ENABLED=true
