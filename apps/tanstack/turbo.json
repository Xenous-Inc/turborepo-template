{
    "$schema": "https://turborepo.com/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".nitro/**", ".output/**", ".tanstack/**"]
        },
        "dev": {
            "dependsOn": ["@xenous/i18n#compile"],
            "persistent": true
        },
        "typecheck": {
            "dependsOn": ["server#build:types"]
        }
    }
}
