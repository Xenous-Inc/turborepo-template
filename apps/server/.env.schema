# Config for the `server` app.
#
# @defaultRequired=infer
# @defaultSensitive=false
#
# @import(../../, pick=[NODE_ENV, DOCKER, PORT, HOST, COOLIFY_*, SOURCE_COMMIT])
# @import(../../packages/db/) # Unfiltered: takes whatever @xenous/db declares it needs.
#
# @generateTsTypes(path=./env.d.ts)
# ---

# Generate with `openssl rand -base64 32`, keep it in `.env.local`.
# @required @sensitive @type=string(minLength=32)
# @docs("Better Auth", https://better-auth.com/docs/installation)
BETTER_AUTH_SECRET=

# Public base URL Better Auth builds callback URLs from.
# @required @dynamic @type=url
BETTER_AUTH_URL=http://localhost:3000

# Credentialed origins; also Better Auth trusted origins. Full origins only - without a scheme,
# `localhost:3001` parses as protocol `localhost:` and its origin reads back as the string `null`.
# `*` matches one label, so `https://*.preview.example.com` covers a preview deployment.
# @required @dynamic @type=array(url(allowedProtocols=[http, https])) @example="http://a.com,http://b.com"
CORS_ORIGIN=[http://localhost:3001, http://localhost:3002]
