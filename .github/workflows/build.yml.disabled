name: Build

on:
    # Called by version.yml after a release. A `workflow_call` runs inside the caller's
    # run, so it sidesteps the rule that refs pushed with GITHUB_TOKEN start no workflows.
    workflow_call:
    workflow_dispatch:
    # Only fires for a tag pushed by a person; GITHUB_TOKEN pushes are ignored by GitHub.
    push:
        tags: ['v*']

concurrency:
    # Don't run the same tag twice in parallel; different tags can run concurrently.
    # Never cancel: a half-finished run can leave some images pushed and others not.
    group: ${{ github.workflow }}-${{ github.ref }}
    cancel-in-progress: false

env:
    FORCE_COLOR: 3
    REGISTRY: ghcr.io

jobs:
    build:
        name: Build ${{ matrix.app }}
        runs-on: ubuntu-latest
        permissions:
            contents: read
            packages: write
        strategy:
            fail-fast: false
            matrix:
                app: [server, web, tanstack]
        steps:
          - name: Checkout
            uses: actions/checkout@v4

          - name: Set up Buildx
            uses: docker/setup-buildx-action@v3

          - name: Log in to the registry
            uses: docker/login-action@v3
            with:
                registry: ${{ env.REGISTRY }}
                username: ${{ github.actor }}
                password: ${{ secrets.GITHUB_TOKEN }}

          # Values are passed as BuildKit secrets, matching the `--mount=type=secret,id=X,env=X`
          # lines in each Dockerfile. Unset ones are skipped - `required` defaults to false - so
          # each app only receives what it declares.
          - name: Build and push
            uses: docker/build-push-action@v6
            with:
                context: .
                file: ./apps/${{ matrix.app }}/Dockerfile
                push: true
                tags: ${{ env.REGISTRY }}/${{ github.repository }}/${{ matrix.app }}:${{ github.sha }}
                cache-from: type=gha,scope=${{ matrix.app }}
                cache-to: type=gha,scope=${{ matrix.app }},mode=max
                secrets: |
                    DATABASE_URL=${{ secrets.DATABASE_URL }}
                    BETTER_AUTH_SECRET=${{ secrets.BETTER_AUTH_SECRET }}
                    BETTER_AUTH_URL=${{ secrets.BETTER_AUTH_URL }}
                    CORS_ORIGIN=${{ secrets.CORS_ORIGIN }}
                    NEXT_PUBLIC_SERVER_URL=${{ secrets.NEXT_PUBLIC_SERVER_URL }}
                    SERVER_URL=${{ secrets.SERVER_URL }}
                    VITE_SERVER_URL=${{ secrets.VITE_SERVER_URL }}
                    TURBO_TEAM=${{ vars.TURBO_TEAM }}
                    TURBO_TOKEN=${{ secrets.TURBO_TOKEN }}
