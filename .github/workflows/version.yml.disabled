name: Version

permissions:
    contents: write
    pull-requests: write

on:
    push:
        branches: [main]

concurrency:
    group: ${{ github.workflow }}-${{ github.ref }}
    cancel-in-progress: false

jobs:
    version:
        name: Version
        runs-on: ubuntu-latest
        outputs:
            published: ${{ steps.changesets.outputs.published }}
        steps:
          - name: Checkout
            uses: actions/checkout@v4
            with:
                fetch-depth: 0

          - name: Setup
            uses: ./tooling/github/setup

          - name: Configure git identity
            run: |
                git config user.name 'github-actions[bot]'
                git config user.email '41898282+github-actions[bot]@users.noreply.github.com'

          # `publish-script` is what makes the action tag on the release push - without it
          # it returns early and never sets the `published` output the build job gates on.
          - name: Changesets — version PR or tag
            id: changesets
            uses: changesets/action@v2
            with:
                version-script: pnpm changeset version
                publish-script: pnpm changeset tag
                pr-title: 'chore(version): update package versions'
                commit-message: 'chore(version): update package versions'
                # Tags are enough; Releases would be one per package on every bump.
                create-github-releases: false

    # Uncomment once build.yml is enabled - `uses:` resolves by path, so referencing a
    # still-disabled file fails to parse. Builds and pushes images for the versions just
    # released, from inside this run rather than via the tag push, which GitHub ignores
    # when the tag was pushed with GITHUB_TOKEN.
    #
    # build:
    #     name: Build
    #     needs: version
    #     if: needs.version.outputs.published == 'true'
    #     uses: ./.github/workflows/build.yml
    #     # A called workflow inherits no secrets by default - without this, every
    #     # `${{ secrets.* }}` in build.yml resolves to an empty string.
    #     secrets: inherit
