{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "globalDependencies": [".env.schema"],
    "globalEnv": ["NODE_ENV", "DOCKER", "NEXT_PUBLIC_*", "VITE_*"],
    "globalPassThroughEnv": ["CI", "HOST", "PORT", "GITHUB_*", "VARLOCK_*"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".cache/tsbuildinfo.json", "dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "check": {
            "dependsOn": ["^check"]
        },
        "check:fix": {
            "dependsOn": ["^check:fix"],
            "cache": false
        },
        "check:unsafe": {
            "dependsOn": ["^check:unsafe"],
            "cache": false
        },
        "ci": {
            "dependsOn": ["^ci"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "outputs": [".cache/tsbuildinfo.json"]
        },
        "clean": {
            "cache": false
        }
    }
}
