# Shared ambient config: runtime mode plus what the deploy platform injects.
# Anything with a single consumer is declared by that package instead.
# No @currentEnv - values come from .env.local locally, Coolify env in deploys.
#
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# @type=enum(development, production, test) @auditIgnore
NODE_ENV=development

# Switches Next.js to standalone output.
# @optional @type=boolean @example=true @auditIgnore
DOCKER=

# Bind address, set by the platform at runtime.
# @optional @dynamic @type=port @auditIgnore
PORT=
# @optional @dynamic @auditIgnore
HOST=

# Coolify predefined vars, absent locally.
# @docs(https://coolify.io/docs/knowledge-base/environment-variables#predefined-variables)
# @optional @auditIgnore
COOLIFY_FQDN=
# @optional @auditIgnore
COOLIFY_URL=
# @optional @auditIgnore
COOLIFY_BRANCH=
# @optional @auditIgnore
COOLIFY_RESOURCE_UUID=
# @optional @auditIgnore
COOLIFY_CONTAINER_NAME=
# @optional @auditIgnore
SOURCE_COMMIT=
